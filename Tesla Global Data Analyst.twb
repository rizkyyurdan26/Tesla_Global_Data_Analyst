  <dashboards>
    <dashboard name='Insight Reports' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Insights of Report</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='219' />
          <format attr='background-color' value='#a0cbe8' />
          <format attr='font-family' value='Arial' />
          <format attr='font-size' value='10' />
        </style-rule>
        <style-rule element='story-title'>
          <format attr='border-color' value='#000000' />
          <format attr='border-style' value='solid' />
          <format attr='font-family' value='Arial' />
          <format attr='font-weight' value='bold' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='2801' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='195' h='20228' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='3631' />
            <zone h='75311' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='23859'>
              <flipboard active-id='9' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='1. Region Domination&#10;- Region yang paling dominan berdasarkan Delivery dan Revenue adalah Middle Eats&#10;' captured-sheet='Delivery &amp; Revenue per Region' id='3' />
                  <story-point caption='2. Deliveries&#10;- Puncak penjualan global Tesla pada tahun 2022, kemudian menurun drastis pada 2023, sempat naik pada 2024, dan turun lagi pada tahun 2025&#10;&#10;- Penjualan Tesla secara global terburuk pada tahun 2020, hal ini dapat disebabkan karena efek dari covid 19' captured-sheet='Global Deliveries (Trend)' id='4' />
                  <story-point caption='3. Models&#10;- Model yang paling diminati adalah model S, sedangkan model yang paling sedikit peminatnya adalah Cybertruck. Hal ini sangat masuk akal terjadi, karena Cybertruck ditujukan untuk kalangan tertentu, targetnya bukan semua kalangan ' captured-sheet='Total delivery per model' id='6' />
                  <story-point caption='4. Deliveries vs Production&#10;- Terlihat bahwa produksi diilakukan sesuai estimasi delivery. &#10;- Namun, Gap antara produksi dengan deliveries &gt; 350 untuk semua unit, Ini menandakan potensi inventory build-up → biaya logistik + penyimpanan naik, risiko depresiasi unit meningkat. sisa mobil yang diproduksi berisiko tidak laku' captured-sheet='Gap' id='7' />
                  <story-point caption='5. Revenue&#10;- Semua model menunjukkan pola naik–turun yang cukup tajam setiap tahun. Tidak ada model yang memiliki pola pertumbuhan stabil.&#10;- Permintaan pasar Tesla tidak sepenuhnya stabil dan sangat sensitif terhadap kondisi ekonomi global.' captured-sheet='Revenue Trend' id='8' />
                  <story-point caption='6. Efficiency Battery&#10;- Semua model Tesla memiliki kapasitas baterai yang merata, dengan perhitungan jarak tempuh / kapsistas baterai' captured-sheet='Battery Efficiency' id='9' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{F21C3406-F45D-42A5-B0E1-38D07F3CDDBC}' />
    </dashboard>
